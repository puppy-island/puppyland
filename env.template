# ============================================================
# 记忆家园 Memory Home — 环境变量模板
# 复制为 .env 后填入实际值
# ============================================================

# ── 后端服务 ───────────────────────────────────────────────
# FastAPI 后端监听地址（前端 MEMORY_HOME_API 需与此一致）
HOST=0.0.0.0
PORT=8001

# ── 腾讯云实时语音识别（ASR）───────────────────────────────
# 文档：https://cloud.tencent.com/document/product/1093/48982
# 签名前往 backend_app/realtime_asr.py 查看签名算法
# 若不配置：前端录音降级为 Mock ASR（本地随机返回示例文本）
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
ASR_APP_ID=

# ASR 参数（通常不需要修改）
ASR_ENGINE_MODEL=16k_zh   # 16k_zh = 中文16kHz；其他可选 16k_zh-P2 等
ASR_VOICE_FORMAT=1        # 1 = PCM（必须为 1，前端只支持 PCM）

# ── LLM 接口（支持 OpenAI 兼容格式）────────────────────────
# 支持：OpenAI、SiliconFlow、SiliconFlow V3、DeepSeek、阿里云等
# 实际 base_url 示例：
#   OpenAI:              https://api.openai.com/v1
#   SiliconFlow:         https://api.siliconflow.cn/v1
#   SiliconFlow V3:      https://ark.cn-beijing.volces.com/api/v3
#   DeepSeek:            https://api.deepseek.com/v1
#   阿里云 DashScope:    https://dashscope.aliyuncs.com/compatible-mode/v1

BASE_URL=https://ark.cn-beijing.volces.com/api/v3
API_KEY=
MODEL=deepseek-chat

# ── 生成狗狗形象（AI 图片）─────────────────────────────────
# 图片生成使用的模型（留空则使用默认的 LLM 图片生成接口）
# IMAGE_MODEL=deepseek-chat
