FROM python:3.11-slim

WORKDIR /app

# 避免容器默认 C/POSIX locale 引发的编码问题
ENV LANG=C.UTF-8 \
    PYTHONIOENCODING=utf-8

COPY prototype/ ./prototype/

RUN apt-get update && apt-get install -y --no-install-recommends \
    nodejs npm \
    && npm install -g html-minifier \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Build static files
RUN python prototype/build.py

WORKDIR /app/prototype/dist

# 容器启动时：如果传入了 PUPPYLAND_API（如 http://backend:8001）则替换内置的后端地址；
# 为空时保持内置默认值（localhost:8001，本地开发用），由 Caddy 在运行时做反代。
CMD ["sh", "-c", "\
sed -i 's|http://localhost:8001/api/v1|${PUPPYLAND_API:-http://localhost:8001}/api/v1|g' index.html && \
python -m http.server 4321"]
