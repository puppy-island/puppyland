# ==========================================
# 记忆家园 - 环境变量配置示例
# 复制此文件为 .env 后填入实际值
# ==========================================

# ---- 后端服务 ----
PORT=8001                    # 后端服务端口
HOST=0.0.0.0                 # 后端监听地址（开发环境用 0.0.0.0，生产环境建议改为 127.0.0.1）

# ---- LLM 配置（OpenAI 兼容格式）----
# 支持 deepseek、Qwen 等 OpenAI-compatible API
model=deepseek-v4-flash      # 模型名称
base_url=https://api.openai-next.com/v1   # API 地址
api_key=your-api-key-here    # API 密钥

# ---- 腾讯云实时语音识别（ASR）----
# 用于语音输入转文字功能
# 申请地址：https://cloud.tencent.com/document/product/1093/48982
TENCENT_SECRET_ID=your-tencent-secret-id      # 腾讯云 SecretId
TENCENT_SECRET_KEY=your-tencent-secret-key    # 腾讯云 SecretKey（不要泄露给前端）
ASR_APP_ID=your-app-id                         # 腾讯云 AppId
